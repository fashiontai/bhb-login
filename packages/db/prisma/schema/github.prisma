model GithubAccount {
  id              String                 @id @default(cuid())
  githubId        Int                    @unique
  login           String
  name            String?
  avatarUrl       String?
  profileUrl      String
  bio             String?
  company         String?
  blog            String?
  location        String?
  email           String?
  publicRepos     Int
  followers       Int
  following       Int
  githubCreatedAt DateTime
  githubUpdatedAt DateTime
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  fields          GithubAccountField[]
  introductions   PersonalIntroduction[]

  @@index([login])
  @@map("github_account")
}

model GithubAccountField {
  id        String        @id @default(cuid())
  accountId String
  key       String
  value     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  account   GithubAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, key])
  @@index([accountId])
  @@map("github_account_field")
}

model PersonalIntroduction {
  id                String        @id
  githubAccountId   String        @map("github_account_id")
  generatedByUserId String?       @map("generated_by_user_id")
  locale            String
  content           String
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  githubAccount     GithubAccount @relation(fields: [githubAccountId], references: [id], onDelete: Cascade)
  generatedByUser   User?         @relation(fields: [generatedByUserId], references: [id], onDelete: SetNull)

  @@unique([githubAccountId, locale])
  @@index([generatedByUserId])
  @@map("personal_introduction")
}
